# LIBRIX Frontend - Environment Configuration Example
# Copy this file to .env.local for local overrides if needed.
# For Vercel production deployment: Set this variable in Vercel Project Settings -> Environment Variables.

# Production Backend Base URL (NO trailing slash, do not include /api)
# Example: https://ds-project-backend.vercel.app
VITE_API_URL=https://YOUR-ACTUAL-BACKEND-DOMAIN.vercel.app
